
/*
Q26
Find all completed orders for which the payment status is not Paid.

*/

SELECT C.CUSTOMER_NAME, ORDER_STATUS,PAYMENT_STATUS
FROM CUSTOMERS AS C
JOIN ORDERS AS O
ON C.CUSTOMER_ID = O.CUSTOMER_ID
LEFT JOIN PAYMENTS AS PM
ON O.ORDER_ID = PM.ORDER_ID
WHERE ORDER_STATUS = 'COMPLETED' AND PAYMENT_STATUS != 'PAID'
GROUP BY C.CUSTOMER_NAME, ORDER_STATUS, PAYMENT_STATUS
;


