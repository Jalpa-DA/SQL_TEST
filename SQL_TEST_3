/*

Q31
Create a report containing customer name, order ID, product name, sales employee name, department, quantity, and total order value.

*/

SELECT * 
FROM CUSTOMERS, ORDERS, PRODUCTS;

SELECT *
FROM EMPLOYEES;


SELECT CUSTOMER_NAME, ORDER_ID, PRODUCT_NAME, EMPLOYEE_NAME AS SALES_EMPLOYEE_NAME, DEPARTMENT, QUANTITY, 
SUM(O.QUANTITY*P.UNIT_PRICE) AS TOTAL_ORDER_VALUE
FROM CUSTOMERS AS C
INNER JOIN ORDERS AS O
ON C.customer_id = O.customer_id
JOIN PRODUCTS AS P
ON P.PRODUCT_ID = O.product_id
JOIN EMPLOYEES AS E
ON O.sales_employee_id = E.EMPLOYEE_ID
GROUP BY CUSTOMER_NAME, ORDER_ID, PRODUCT_NAME, EMPLOYEE_NAME, DEPARTMENT, QUANTITY
;

/*

Q32
Find the total revenue generated by each sales employee from completed orders only.


*/

SELECT EMPLOYEE_NAME AS SALES_EMPLOYEE_NAME, ORDER_STATUS, 
SUM(O.QUANTITY*P.UNIT_PRICE) AS TOTAL_ORDER_VALUE
FROM CUSTOMERS AS C
INNER JOIN ORDERS AS O
ON C.customer_id = O.customer_id
JOIN PRODUCTS AS P
ON P.PRODUCT_ID = O.product_id
JOIN EMPLOYEES AS E
ON O.sales_employee_id = E.EMPLOYEE_ID
WHERE ORDER_STATUS = 'COMPLETED'
GROUP BY EMPLOYEE_NAME, ORDER_STATUS
;

/*

Q33
Find sales employees whose completed-order revenue is greater than ₹500,000.

*/

SELECT EMPLOYEE_NAME AS SALES_EMPLOYEE_NAME, ORDER_STATUS, 
SUM(O.QUANTITY*P.UNIT_PRICE) AS TOTAL_ORDER_VALUE
FROM CUSTOMERS AS C
INNER JOIN ORDERS AS O
ON C.customer_id = O.customer_id
JOIN PRODUCTS AS P
ON P.PRODUCT_ID = O.product_id
JOIN EMPLOYEES AS E
ON O.sales_employee_id = E.EMPLOYEE_ID
WHERE ORDER_STATUS = 'COMPLETED'
GROUP BY EMPLOYEE_NAME, ORDER_STATUS
HAVING SUM(O.QUANTITY*P.UNIT_PRICE) > 500000
ORDER BY TOTAL_ORDER_VALUE DESC
;

