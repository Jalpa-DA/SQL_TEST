/*

Q49
For each customer segment, compare completed-order revenue for pairs of customers in the same segment.
Display the two customer names and their revenues only when the first customer's revenue is greater than the second customer's revenue.

*/


SELECT CUSTOMER_NAME, CUSTOMER_SEGMENT, ORDER_STATUS, 
SUM(QUANTITY*UNIT_PRICE) AS TOTAL_ORDER_REVENUE
FROM CUSTOMERS AS C
JOIN ORDERS AS O
ON C.CUSTOMER_ID = O.CUSTOMER_ID
JOIN PRODUCTS AS P
ON P.PRODUCT_ID = O.PRODUCT_ID
WHERE ORDER_STATUS = 'COMPLETED' OR ORDER_STATUS <> 'COMPLETED'
GROUP BY CUSTOMER_NAME, CUSTOMER_SEGMENT, ORDER_STATUS
ORDER BY TOTAL_ORDER_REVENUE DESC
;


/*

Q50
Build a management-level sales report showing 
customer segment, number of customers, number of completed orders, total quantity sold, total revenue, and average order value. 
Include segments even if a metric has no matching records.


*/


SELECT CUSTOMER_SEGMENT, 
COUNT(C.CUSTOMER_ID) AS NUMBER_OF_CUSTOMERS, 
COUNT(ORDER_ID) AS NUMBER_OF_COMPLETED_ORDERS, 
SUM(QUANTITY) AS TOTAL_QUANTITY_SOLD,
SUM(QUANTITY*UNIT_PRICE) AS TOTAL_REVENUE,
AVG(QUANTITY*UNIT_PRICE) AS AVG_ORDER_VALUE
FROM CUSTOMERS AS C
