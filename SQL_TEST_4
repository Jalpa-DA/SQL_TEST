/*

Q44
Find the average completed order value for each customer segment.


*/

SELECT CUSTOMER_SEGMENT,
SUM(QUANTITY*UNIT_PRICE) AS ORDER_VALUE,
AVG(QUANTITY*UNIT_PRICE) AS AVG_ORDER_VALUE
FROM CUSTOMERS AS C
JOIN ORDERS AS O
ON C.CUSTOMER_ID = O.CUSTOMER_ID
JOIN PRODUCTS AS P
ON P.PRODUCT_ID = O.PRODUCT_ID
WHERE ORDER_STATUS = 'COMPLETED'
GROUP BY CUSTOMER_SEGMENT
;


/*

Q45
Find customer segments whose average completed order value is greater than ₹50,000.


*/

SELECT CUSTOMER_SEGMENT,
AVG(QUANTITY*UNIT_PRICE) AS AVG_ORDER_VALUE
FROM CUSTOMERS AS C
JOIN ORDERS AS O
ON C.CUSTOMER_ID = O.CUSTOMER_ID
JOIN PRODUCTS AS P
ON P.PRODUCT_ID = O.PRODUCT_ID
WHERE ORDER_STATUS = 'COMPLETED'
GROUP BY CUSTOMER_SEGMENT
HAVING AVG(QUANTITY*UNIT_PRICE) > 50000
;



/*

Q46
Create a business performance report by sales employee
showing employee name, department, number of completed orders, total quantity sold, total revenue, and average order value.

*/


SELECT EMPLOYEE_NAME, DEPARTMENT, 
COUNT(ORDER_STATUS) AS NUMBER_OF_ORDER_STATUS,
COUNT(QUANTITY) AS NUMBER_OF_QUANTITY,
SUM(QUANTITY*UNIT_PRICE) AS TOTAL_REVENUE,
AVG(QUANTITY*UNIT_PRICE) AS AV_ORDER_VALUE
FROM EMPLOYEES AS E
JOIN ORDERS AS O
ON E.EMPLOYEE_ID = O.SALES_EMPLOYEE_ID
JOIN PRODUCTS AS P
ON P.PRODUCT_ID = O.PRODUCT_ID
WHERE ORDER_STATUS = 'COMPLETED'
GROUP BY EMPLOYEE_NAME, DEPARTMENT
;



/*

Q47
Find the sales employee with the highest completed-order revenue without using subqueries or window functions.


*/

SELECT EMPLOYEE_NAME, DEPARTMENT, 
COUNT(ORDER_STATUS) AS NUMBER_OF_ORDER_STATUS,
COUNT(QUANTITY) AS NUMBER_OF_QUANTITY,
SUM(QUANTITY*UNIT_PRICE) AS TOTAL_REVENUE,
AVG(QUANTITY*UNIT_PRICE) AS AV_ORDER_VALUE
FROM EMPLOYEES AS E
JOIN ORDERS AS O
ON E.EMPLOYEE_ID = O.SALES_EMPLOYEE_ID
JOIN PRODUCTS AS P
ON P.PRODUCT_ID = O.PRODUCT_ID
WHERE ORDER_STATUS = 'COMPLETED'
GROUP BY EMPLOYEE_NAME, DEPARTMENT
ORDER BY TOTAL_REVENUE DESC
;


